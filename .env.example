DATABASE_URL=postgres://mulsanne:mulsanne@localhost:5432/mulsanne
BIND_ADDR=0.0.0.0:8080
# Read the client IP from X-Forwarded-For (only behind a trusted proxy).
TRUST_FORWARDED=0
RUST_LOG=mulsanne_server=info,tower_http=info
# S3-compatible storage for lap traces (R2, B2, MinIO, …). Without
# S3_BUCKET the server runs with traces disabled.
S3_BUCKET=mulsanne-traces
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Only for a local MinIO over plain http.
S3_ALLOW_HTTP=1
