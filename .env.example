DATABASE_URL=postgres://mulsanne:mulsanne@localhost:5432/mulsanne
# Or PORT (set by Cloud Run and similar hosts); BIND_ADDR wins if both are set.
BIND_ADDR=0.0.0.0:8080
# Proxies in front of the server that append to X-Forwarded-For (0 when exposed
# directly). Check a deployment with GET /v1/ip; see crates/api/src/auth.rs.
TRUSTED_PROXY_HOPS=0
RUST_LOG=mulsanne_server=info,tower_http=info
# S3-compatible storage for lap traces (R2, B2, MinIO, …). Without
# S3_BUCKET the server runs with traces disabled.
S3_BUCKET=mulsanne-traces
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Only for a local MinIO over plain http.
S3_ALLOW_HTTP=1
